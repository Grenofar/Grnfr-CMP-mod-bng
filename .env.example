# Copiez ce fichier en .env (ignoré par git) pour un build/release en local. Sur Vercel, mettez SUPABASE_URL et
# SUPABASE_ANON_KEY dans Settings > Environment Variables (jamais SUPABASE_SERVICE_ROLE_KEY : Vercel ne fait pas de releases).

# Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Project Settings > API > anon public (jamais service_role) : utilisée par scripts/build.mjs, embarquée dans le mod et le site.
SUPABASE_ANON_KEY=

# Project Settings > API > service_role (SECRÈTE : jamais commitée, jamais dans le mod ni le site). Utilisée
# UNIQUEMENT par scripts/release.mjs (npm run release) pour publier une release sur Supabase Storage.
SUPABASE_SERVICE_ROLE_KEY=
