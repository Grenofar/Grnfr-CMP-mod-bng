{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRNFR CMP Launcher",
  "version": "0.1.1",
  "identifier": "com.grnfr.cmplauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GRNFR CMP Launcher",
        "width": 820,
        "height": 640,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQjY4OEQ0MkNFREVFMkIKUldRcjd1MHMxSWkyclFVVmc0azdWMldJYSt6d3djb0lTYk1lQ3d2UG0wNXRQVlFvMDdiWEVBajMK",
      "endpoints": [
        "https://github.com/Grenofar/Grnfr-CMP-mod-bng/releases/download/launcher-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
